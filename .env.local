# ─────────────────────────────────────────────
#  GhostType configuration template
#
#  Copy this file to `.env` and edit values there:
#     cp .env.local .env
#
#  `.env` is gitignored, so your personal settings never get committed.
#  This file (.env.local) is the tracked example — keep it in sync with
#  any new settings you add, but don't put real/private values in it.
# ─────────────────────────────────────────────

# Speed preset: slow (~30 WPM) | normal (~60 WPM) | fast (~120 WPM)
SPEED=normal

# Exact words-per-minute. Overrides SPEED when set. Leave blank to use SPEED.
WPM=

# Pause after every "." — long enough for Google Docs to register + save.
# A single number ("5.0") or a random range ("4.5,5.5").
FULLSTOP_PAUSE=4.5,5.5

# Stop (like the full-stop pause) at other punctuation: , ; : ! ?
# Off by default — otherwise they just add a small jitter to typing speed.
PUNCTUATION_PAUSE_ENABLED=false
PUNCTUATION_PAUSE=1.0,2.0

# Pause every N words (randomized 1 word around this) — forces a version
# history checkpoint in Google Docs.
WORD_CHUNK_SIZE=9
WORD_CHUNK_PAUSE=4.5,5.5

# File to type when no file is passed on the command line.
INPUT_FILE=input.txt

# Seconds to wait after confirming, before typing starts.
COUNTDOWN=5

# Chance (0.0–1.0) that any given letter is mistyped, paused on, backspaced,
# and retyped correctly — adds realistic human typos. 0 disables it.
TYPO_CHANCE=0
TYPO_PAUSE=0.15,0.35

# Occasional longer "thinking" pauses scattered through the text.
THINKING_PAUSE_EVERY=80
THINKING_PAUSE_CHANCE=0.25
THINKING_PAUSE_RANGE=0.4,1.2

# Play a bell/desktop notification when typing finishes (true/false).
SOUND_ON_COMPLETE=true

# Colored terminal output (true/false).
COLOR_OUTPUT=true
